generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WorkspaceProfile {
  id          String   @id @default("default")
  displayName String   @default("Nexus User")
  initials    String   @default("NU")
  timezone    String   @default("Asia/Tehran")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookEndpoint {
  id             String    @id @default(cuid())
  name           String
  url            String
  enabled        Boolean   @default(true)
  lastTestedAt   DateTime?
  lastTestStatus String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([enabled, name])
}

model Workflow {
  id          String        @id @default(cuid())
  name        String
  description String        @default("")
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  isFavorite  Boolean       @default(false)
  isEnabled   Boolean       @default(true)
  tags        String        @default("[]")
  nodes       WorkflowNode[]
  edges       WorkflowEdge[]
  runs        WorkflowRun[]
  inboxMessages InboxMessage[]
}

model WorkflowNode {
  id            String         @id
  workflowId    String
  kind          String
  title         String
  description   String         @default("")
  meta          String         @default("")
  positionX     Float
  positionY     Float
  config        String         @default("{}")
  workflow      Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  outgoingEdges WorkflowEdge[] @relation("EdgeSource")
  incomingEdges WorkflowEdge[] @relation("EdgeTarget")

  @@index([workflowId])
}

model WorkflowEdge {
  id           String       @id
  workflowId   String
  sourceNodeId String
  targetNodeId String
  sourceHandle String?
  targetHandle String?
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceNode   WorkflowNode @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: NoAction)
  targetNode   WorkflowNode @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: NoAction)

  @@index([workflowId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model WorkflowRun {
  id          String            @id @default(cuid())
  workflowId  String
  status      String
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  error       String?
  result      String?
  workflow    Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps       WorkflowRunStep[]
  inboxMessages InboxMessage[]

  @@index([workflowId, startedAt])
}

model InboxMessage {
  id         String      @id @default(cuid())
  workflowId String
  runId      String
  title      String
  body       String
  status     String      @default("unread")
  createdAt  DateTime    @default(now())
  readAt     DateTime?
  archivedAt DateTime?
  workflow   Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([workflowId, createdAt])
  @@index([runId])
}

model WorkflowRunStep {
  id          String      @id @default(cuid())
  runId       String
  nodeId      String
  kind        String
  status      String
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  input       String?
  output      String?
  error       String?
  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, startedAt])
}
